{
    "calibration_settings":{

        "N_mcmc": 20000,

        "burn_in": 1000,

        "adapt_interval": 50,

        "posterior_predictive_samples": 200,

        "theta_settings": {
            "theta_initialization":"fixed",

            "fixed_settings": {
                "use_mean": true,
                "fixed_values": [0.5, 0.5],
                "fixed_labels": ["theta_1", "theta_2"]
            },

            "compositional_settings":{
                "compositional_calibration": true
            }
        },

        "allow_singular_cov": true,

        "target_accept": 0.35,

        "mh_scale_kappa_prior": 0.5,

        "mh_scales":{
            "log_ell_kappa": 0.1,
            "log_var_kappa": 0.1
        },

       "shrinkage_models": {

            "delta_eta": {

                "shrinkage_prior": "gp",

                "gp": {
                    "ell_init": 0.01,
                    "var_init": 0.3,

                    "ell_prior": {
                        "mu": 0.1,
                        "sigma": 0.05
                    },

                    "var_prior": {
                        "mu": 0.05,
                        "sigma": 0.05
                    }
                }
            },

            "kappa": {

                "shrinkage_prior": "lasso",
                "groups": false,

                "gp": {
                    "ell_init": 0.01,
                    "var_init": 0.001,

                    "ell_prior": {
                        "mu": 0.1,
                        "sigma": 0.005
                    },

                    "var_prior": {
                        "mu": 0.005,
                        "sigma": 0.5
                    }
                },
                "lasso": {
                    "lambda_init": 0.1,
                    "lambda_prior": {
                        "shape": 2.0,
                        "rate": 1.0
                    }
                },
                "fused_lasso": {
                    "lambda_init": 0.1,
                    "lambda_prior": {
                        "shape": 2.0,
                        "rate": 1.0
                    }
                },
                "horseshoe": {
                    "tau_init": 0.1,
                    "tau_prior": {
                        "mu": 0.3,
                        "sigma": 0.5
                    }
                },
                "spike_slab": {
                    "pi_init": 0.5,
                    "pi_prior": {
                        "alpha": 0.5,
                        "beta": 0.5
                    },
                    "sigma_spike": 0.3,
                    "sigma_slab": 1.0
                    
                },

                "kappa_groups": [

                    {
                        "indices": [0,1],
                        "method": "gp"
                    },

                    {
                        "indices": [2],
                        "method": "spike_slab"
                    }
                    ]
            }
        },

        "orthogonalization_settings":{

            "orthogonalize_delta_eta": true,

            "theta_epsilon": 1e-2
        },

        "sigma2_prior_val": 0.002,

        "sigma2_prior_vals": {
            "a": 2.0,
            "b": 0.01
        }
    },
    "input_settings":{

        "model_data_path": "/Users/liammyhill/Desktop/gitLocal/MUEXLY/caked-up/studyNo1/modelData/",

        "obs_data_path": "/Users/liammyhill/Desktop/gitLocal/MUEXLY/caked-up/studyNo1/observationData/",

        "input_delimiter": ","

    },
    "cross_validation_settings":{

        "conduct_cross_validation": true,

        "known_theta_form": "constant",

        "known_theta_form_params": {

            "constant": {
                "values": [1.5,1.75]
            },

            "linear": {
                "m": [1],
                "b": [1]
            },

            "trig_funct": {
                "functions": ["cos"]
            }

        },

        "known_delta_form": "trig_funct",

        "known_delta_form_params": {

            "power_law": {
                "coeff": 0.5,
                "exponent": 0.5
            },

             "linear": {
                "m": 0.8,
                "b": 0.5
            },

            "polynomial": {
                "coeffs": [0.8, 2, 1.8]
            },

            "trig_funct": {
                "function": "cos"
            }
        },

        "holdout_data": false,

        "holdout_data_paths": 
        {
            "appDomain_holdout":"/home/liammyhill/gitLocal/lmyhill/embeddedModel_toyProb/10pct/observationData/appDomain_holdout.txt",
            "observationData_holdout":"/home/liammyhill/gitLocal/lmyhill/embeddedModel_toyProb/10pct/observationData/observationData_holdout.txt"
        }

    },
    
    "plot_settings": {
        "observation_data_label": "SyntheticObservation",
        "simulation_data_label": "Synthetic Experiment",
        "emulator_prior_label": "$\\mathcal{E}(x,\\eta(x))$",
        "posterior_mean_label": "Posterior Mean",
        "posterior_prediction_label": "Posterior prediction",
        "holdout_data_label": "Holdout data",
